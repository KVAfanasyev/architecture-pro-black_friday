@startuml
!define COLLECTION class
!define RELATIONSHIP association

COLLECTION products {
  _id: ObjectId
  name: String
  category: String
  price: Decimal128
  attributes: Object
  created_at: Date
  updated_at: Date
}

COLLECTION inventory {
  _id: ObjectId
  product_id: ObjectId
  geo_zone: String
  quantity: Number
  reserved: Number
  created_at: Date
  updated_at: Date
}

COLLECTION orders {
  _id: ObjectId
  user_id: ObjectId
  geo_zone: String
  order_date: Date
  items: Array
  status: String
  total_amount: Decimal128
  created_at: Date
  updated_at: Date
}

COLLECTION carts {
  _id: ObjectId
  user_id: ObjectId
  session_id: String
  geo_zone: String
  items: Array
  status: String
  created_at: Date
  updated_at: Date
  expires_at: Date
}

products ||..|| inventory : "1:N"
inventory }|..|| orders : "используется в"
inventory }|..|| carts : "резервируется в"
carts ||..|| orders : "преобразуется в"

@enduml